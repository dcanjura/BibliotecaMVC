@model BibliotecaMVC.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center cuenta-contenedor">
    <div class="col-md-7 col-lg-5">
        <div class="card cuenta-tarjeta shadow-sm">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h1 class="h3">Iniciar sesión</h1>
                    <p class="text-muted mb-0">Accede a Biblioteca Virtual.</p>
                </div>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="UsuarioOCorreo" class="form-label"></label>
                        <input asp-for="UsuarioOCorreo" class="form-control" autocomplete="username" />
                        <span asp-validation-for="UsuarioOCorreo" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Contrasena" class="form-label"></label>
                        <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Contrasena" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="Recordarme" class="form-check-input" />
                        <label asp-for="Recordarme" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Ingresar</button>
                </form>

                <p class="text-center mt-3 mb-0">
                    ¿No tienes una cuenta? <a asp-action="Registro">Regístrate</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
