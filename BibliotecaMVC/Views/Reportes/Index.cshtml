@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Reportes de libros";
}

<div class="text-center mb-4">
    <h1>Reportes de libros</h1>
    <p class="text-muted">Consulta y descarga la información registrada en la biblioteca.</p>
</div>

<div class="row justify-content-center g-4">
    <div class="col-md-5">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center p-4">
                <h2 class="h4">Reporte PDF</h2>
                <p>Genera un documento con el listado de libros, autores y categorías.</p>
                <a class="btn btn-danger" asp-action="LibrosPdf">Generar reporte PDF</a>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card h-100 shadow-sm">
            <div class="card-body text-center p-4">
                <h2 class="h4">Reporte Excel</h2>
                <p>Exporta el listado de libros en una hoja de cálculo organizada.</p>
                <a class="btn btn-success" asp-action="LibrosExcel">Exportar a Excel</a>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info mt-4" role="alert">
    Se incluirán @Model.Count() libro(s) registrados al momento de generar el reporte.
</div>
