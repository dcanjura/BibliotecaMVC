@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Catálogo de Libros";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="text-muted">Hay @Model.Count() libros registrados</p>
    </div>
    @if (User.IsInRole("Administrador"))
    {
        <a class="btn btn-primary" asp-action="Create">Nuevo Libro</a>
    }
    else
    {
        <span class="badge bg-secondary">Modo consulta</span>
    }
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var libro in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrWhiteSpace(libro.Imagen))
                {
                    <img src="~/images/@libro.Imagen" class="card-img-top libro-portada"
                         alt="Imagen representativa de @libro.Titulo" />
                }
                else
                {
                    <div class="libro-sin-imagen">Sin imagen disponible</div>
                }
                <div class="card-body">
                    <h5 class="card-title">@libro.Titulo</h5>
                    <p class="card-text mb-1"><strong>Autor:</strong> @libro.Autor</p>
                    <p class="card-text mb-1"><strong>Categoría:</strong> @libro.Categoria</p>
                    <p class="card-text"><strong>Precio:</strong> @libro.Precio.ToString("C")</p>
                    <span class="badge @(libro.Disponible ? "bg-success" : "bg-danger")">
                        @(libro.Disponible ? "Disponible" : "Prestado")
                    </span>
                </div>
                <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Biblioteca Virtual</span>
                    @if (User.IsInRole("Administrador"))
                    {
                        <div>
                            <a class="btn btn-outline-warning btn-sm" asp-action="Edit" asp-route-id="@libro.ID">Editar</a>
                            <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@libro.ID">Eliminar</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-4">No hay libros registrados todavía.</div>
}
