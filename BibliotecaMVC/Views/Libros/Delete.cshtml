@model BibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Eliminar Libro";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h1>@ViewData["Title"]</h1>
        <div class="card border-danger shadow-sm">
            <div class="card-body">
                <div class="alert alert-warning">
                    ¿Está seguro de eliminar el libro <strong>@Model.Titulo</strong>?
                </div>
                <p><strong>Autor:</strong> @Model.Autor</p>
                <p><strong>Categoría:</strong> @Model.Categoria</p>
                <p><strong>Precio:</strong> @Model.Precio.ToString("C")</p>

                <form asp-action="Delete" asp-route-id="@Model.ID" method="post">
                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>
