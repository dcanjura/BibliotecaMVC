@{
    ViewData["Title"] = "Inicio";
}

<section class="bg-light p-4 p-md-5 rounded-3 mb-4 text-center">
    <h1 class="display-5">Biblioteca Virtual</h1>
    <p class="lead">Consulta libros, conoce autores y encuentra nuevas lecturas.</p>
    <a class="btn btn-primary me-2" asp-controller="Libros" asp-action="Index">Ver libros</a>
    <a class="btn btn-outline-secondary" asp-controller="Autores" asp-action="Index">Ver autores</a>
</section>

<div class="alert alert-info" role="alert">
    <strong>Información:</strong> Revisa la disponibilidad de los libros antes de solicitar un préstamo.
</div>

<section class="resumen-biblioteca mb-5" aria-label="Resumen de la biblioteca">
    <div><strong>Libros</strong><span>Catálogo variado</span></div>
    <div><strong>Autores</strong><span>Información organizada</span></div>
    <div><strong>Préstamos</strong><span>Consulta de disponibilidad</span></div>
</section>

<section class="mb-5 seccion-servicios">
    <h2 class="text-center mb-4">Servicios de la biblioteca</h2>
    <div class="servicios-flex">
        <div class="servicio-item">
            <div class="card h-100 shadow-sm">
                <img src="https://picsum.photos/200/100?random=libros-@DateTime.Now.Ticks"
                     class="imagen-servicio" alt="Imagen aleatoria para libros" />
                <div class="card-body">
                    <span class="badge bg-primary mb-2">Catálogo</span>
                    <h3 class="h5 card-title">Libros</h3>
                    <p class="card-text">Consulta los libros registrados, su categoría y disponibilidad.</p>
                    <a class="btn btn-sm btn-primary" asp-controller="Libros" asp-action="Index">Consultar</a>
                </div>
            </div>
        </div>

        <div class="servicio-item">
            <div class="card h-100 shadow-sm">
                <img src="https://picsum.photos/200/100?random=autores-@DateTime.Now.Ticks"
                     class="imagen-servicio" alt="Imagen aleatoria para autores" />
                <div class="card-body">
                    <span class="badge bg-success mb-2">Información</span>
                    <h3 class="h5 card-title">Autores</h3>
                    <p class="card-text">Conoce información básica de los autores incluidos en la biblioteca.</p>
                    <a class="btn btn-sm btn-success" asp-controller="Autores" asp-action="Index">Consultar</a>
                </div>
            </div>
        </div>

        <div class="servicio-item">
            <div class="card h-100 shadow-sm">
                <img src="https://picsum.photos/200/100?random=prestamos-@DateTime.Now.Ticks"
                     class="imagen-servicio" alt="Imagen aleatoria para préstamos" />
                <div class="card-body">
                    <span class="badge bg-warning text-dark mb-2">Servicio</span>
                    <h3 class="h5 card-title">Préstamos</h3>
                    <p class="card-text">Consulta la sección de préstamos y el estado de los libros solicitados.</p>
                    <a class="btn btn-sm btn-warning" asp-controller="Home" asp-action="Prestamos">Consultar</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <h2 class="text-center mb-4">Explora la biblioteca</h2>
    <div class="biblioteca-grid">
        <article class="grid-elemento">
            <h3>Literatura</h3>
            <p>Encuentra novelas, cuentos y obras de diferentes autores.</p>
        </article>
        <article class="grid-elemento">
            <h3>Programación</h3>
            <p>Consulta libros relacionados con tecnología y desarrollo web.</p>
        </article>
        <article class="grid-elemento">
            <h3>Autores</h3>
            <p>Conoce la información principal de los autores registrados.</p>
        </article>
        <article class="grid-elemento">
            <h3>Lectura</h3>
            <p>Descubre nuevas opciones para aprender y disfrutar leyendo.</p>
        </article>
    </div>
</section>

<section class="pasos-biblioteca mb-5">
    <div class="pasos-texto">
        <span class="badge bg-success mb-2">Biblioteca Virtual</span>
        <h2>¿Cómo utilizar el sistema?</h2>
        <p>Explora el catálogo, revisa los detalles y consulta si el libro está disponible.</p>
    </div>
    <ol class="lista-pasos">
        <li>Selecciona un módulo del menú.</li>
        <li>Consulta la información registrada.</li>
        <li>Revisa el estado de cada libro.</li>
    </ol>
</section>

<section class="mb-4">
    <h2 class="text-center mb-4">Preguntas frecuentes</h2>
    <div class="accordion" id="preguntasBiblioteca">
        <div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#preguntaUno">
                    ¿Cómo puedo buscar un libro?
                </button>
            </h3>
            <div id="preguntaUno" class="accordion-collapse collapse show" data-bs-parent="#preguntasBiblioteca">
                <div class="accordion-body">
                    Ingresa al módulo Libros para consultar el catálogo disponible.
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#preguntaDos">
                    ¿Qué información puedo consultar?
                </button>
            </h3>
            <div id="preguntaDos" class="accordion-collapse collapse" data-bs-parent="#preguntasBiblioteca">
                <div class="accordion-body">
                    Puedes consultar títulos, autores, categorías, precios y disponibilidad.
                </div>
            </div>
        </div>
    </div>
</section>
