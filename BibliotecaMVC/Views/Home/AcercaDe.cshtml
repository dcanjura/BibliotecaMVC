@{
    ViewData["Title"] = "Acerca de";
}

<div class="pagina-acerca">
    <header class="acerca-encabezado">
        <h1>Acerca de la Biblioteca Virtual</h1>
        <p>Un espacio sencillo para consultar libros, autores y servicios bibliotecarios.</p>
    </header>

    <section class="acerca-contenido">
        <article class="tarjeta-reutilizable">
            <h2>Nuestra biblioteca</h2>
            <p>
                La Biblioteca Virtual fue creada para facilitar la consulta de libros y organizar
                la información de autores, categorías y préstamos.
            </p>
            <p>
                Este proyecto permite practicar el desarrollo de aplicaciones web con ASP.NET Core MVC,
                HTML5 y CSS3.
            </p>
        </article>

        <article class="tarjeta-reutilizable">
            <h2>Servicios disponibles</h2>
            <ul>
                <li>Consulta del catálogo de libros.</li>
                <li>Información de autores.</li>
                <li>Organización por categorías.</li>
                <li>Control básico de préstamos.</li>
            </ul>
        </article>

        <aside class="acerca-nota tarjeta-reutilizable">
            <h2>Objetivo</h2>
            <p>Ofrecer una forma clara y rápida de acceder a la información de la biblioteca.</p>
        </aside>

        <article class="acerca-mision tarjeta-reutilizable">
            <h2>Misión</h2>
            <p>
                Facilitar el acceso a libros, autores y servicios bibliotecarios mediante una
                plataforma sencilla y ordenada.
            </p>
        </article>

        <article class="acerca-vision tarjeta-reutilizable">
            <h2>Visión</h2>
            <p>
                Ser una biblioteca virtual útil para estudiantes y lectores que buscan información
                de manera rápida desde cualquier dispositivo.
            </p>
        </article>
    </section>

    <section>
        <figure class="acerca-imagen">
        <img src="https://picsum.photos/900/350?random=@DateTime.Now.Ticks"
             alt="Imagen aleatoria de Lorem Picsum" />
        <figcaption>Biblioteca virtual desarollada con ASP.NET Core MVC</figcaption>
    </figure>
    </section>

    <section class="valores-biblioteca">
        <h2>Nuestros valores</h2>
        <div class="valores-flex">
            <article class="tarjeta-reutilizable valor-item">
                <h3>Acceso</h3>
                <p>La información debe ser fácil de consultar para todos los usuarios.</p>
            </article>
            <article class="tarjeta-reutilizable valor-item">
                <h3>Organización</h3>
                <p>Los libros y autores se presentan de una manera clara y ordenada.</p>
            </article>
            <article class="tarjeta-reutilizable valor-item">
                <h3>Aprendizaje</h3>
                <p>La lectura ayuda a desarrollar nuevos conocimientos y habilidades.</p>
            </article>
        </div>
    </section>

    <aside class="mensaje-final">
        <h2>Un espacio para lectores</h2>
        <p>La Biblioteca Virtual continúa creciendo para ofrecer una mejor experiencia de consulta.</p>
        <a class="btn btn-light" asp-controller="Libros" asp-action="Index">Explorar libros</a>
    </aside>
</div>
