@{
    ViewData["Title"] = "Ocurrió un problema";
}

<div class="row justify-content-center pagina-error">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm error-tarjeta">
            <div class="card-body text-center p-5">
                <div class="mensaje-icono" aria-hidden="true">📚</div>
                <h1 class="h3">Ocurrió un problema</h1>
                <p class="text-muted">
                    No fue posible completar la operación solicitada. Intenta nuevamente o continúa
                    navegando por la Biblioteca Virtual.
                </p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a class="btn btn-success" asp-controller="Home" asp-action="Index">Ir al inicio</a>
                    <a class="btn btn-outline-secondary" asp-controller="Libros" asp-action="Index">Ver libros</a>
                </div>
            </div>
        </div>
    </div>
</div>
